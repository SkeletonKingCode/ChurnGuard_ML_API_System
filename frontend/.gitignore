# Dependencies & Package Managers (recreated via `npm install`)
node_modules/

# Build & Bundler Output Directories (recreated via `npm run build`)
dist/
dist-ssr/
.vite/
.output/

# Cache directories (recreated by tools/linter)
.cache/
.oxlintrc.json
*.tsbuildinfo

# Logs & Debugging (recreated on run/install errors)
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment & secret files
.env
.env.local
.env.*.local

# OS & Editor files (recreated by OS/IDE)
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
